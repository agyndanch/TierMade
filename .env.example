# --- Database ---------------------------------------------------------------
# Embedded Postgres on disk (no Docker needed) — good for local dev:
DATABASE_URL=pglite://./.data/pglite
# Or a real Postgres (docker compose up -d, or a Neon connection string):
# DATABASE_URL=postgres://tiermade:tiermade@localhost:5432/tiermade

# --- Auth -------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# --- Catalog APIs -------------------------------------------------------------
# Films + TV: https://www.themoviedb.org/settings/api  → "API Read Access Token"
TMDB_API_TOKEN=
# Video games (IGDB): https://dev.twitch.tv/console/apps → register an app
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Music uses the Deezer public API — no key needed.
